# Copy this file to .env on the target server. Values must be true or false.
# Environment variables set by the operating system take precedence over .env.

# Rule-based automatic language detection in Article Studio.
AI_LANGUAGE_DETECTION_ENABLED=true

# TranslateGemma is intentionally disabled until a server-side endpoint exists.
AI_TRANSLATION_ENABLED=false

# Conservative pronunciation preparation and user pronunciation exceptions.
AI_PRONUNCIATION_ENABLED=true

# Optional secret for a server-side TranslateGemma OpenAI-compatible endpoint.
# TRANSLATEGEMMA_API_KEY=
